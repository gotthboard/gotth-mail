compatibility_level = 3.10
myhostname = mail
myorigin = $myhostname
inet_interfaces = all
inet_protocols = ipv4
mynetworks = 127.0.0.0/8
maillog_file = /dev/stdout
enable_long_queue_ids = yes
append_dot_mydomain = no
biff = no
readme_directory = no
html_directory = no
meta_directory = /etc/postfix
shlib_directory = /usr/lib/postfix
queue_directory = /var/spool/postfix
data_directory = /var/spool/postfix/data
command_directory = /usr/sbin
daemon_directory = /usr/libexec/postfix
mail_owner = postfix
setgid_group = postdrop
alias_maps =
alias_database =
local_recipient_maps =
local_transport = error:local delivery disabled
virtual_mailbox_domains = tcp:control-plane:10032
virtual_mailbox_maps = tcp:control-plane:10033
virtual_alias_maps = tcp:control-plane:10034
virtual_transport = lmtp:inet:dovecot:24
default_transport = gotth_policy:
relay_transport = gotth_policy:
smtpd_upstream_proxy_protocol = haproxy
smtpd_upstream_proxy_timeout = 5s
smtpd_sasl_auth_enable = yes
smtpd_sasl_type = dovecot
smtpd_sasl_path = inet:dovecot:12345
smtpd_sasl_security_options = noanonymous
smtpd_sasl_tls_security_options = $smtpd_sasl_security_options
smtpd_tls_security_level = none
smtpd_relay_restrictions = permit_sasl_authenticated, permit_mynetworks, reject
smtpd_recipient_restrictions = check_policy_service inet:control-plane:10031, reject
smtpd_milters = inet:rspamd:11332
non_smtpd_milters = $smtpd_milters
milter_default_action = tempfail
milter_protocol = 6
message_size_limit = 52428800
mailbox_size_limit = 0
recipient_delimiter = +
disable_vrfy_command = yes
smtputf8_enable = yes
import_environment = MAIL_CONFIG MAIL_DEBUG MAIL_LOGTAG TZ XAUTHORITY DISPLAY LANG=C GOTTH_MAIL_CORE_URL GOTTH_MAIL_POSTFIX_HELPER_TOKEN_FILE GOTTH_MAIL_POSTFIX_RELEASE_TOKEN_FILE GOTTH_MAIL_POSTFIX_INSTANCE GOTTH_MAIL_OUTBOUND_RELAY_ADDR
export_environment = TZ LANG GOTTH_MAIL_CORE_URL GOTTH_MAIL_POSTFIX_HELPER_TOKEN_FILE GOTTH_MAIL_POSTFIX_INSTANCE GOTTH_MAIL_OUTBOUND_RELAY_ADDR
